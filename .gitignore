__pycache__/
*.pyc
.env
.venv/
.idea

# local prompt notes/drafts — not part of the project
prompt/

# data lake tiers — regenerable from BigQuery, not versioned.
# .gitkeep files keep the directory structure tracked.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# packaging
*.egg-info/
build/
dist/

# test/tooling caches
.pytest_cache/
.ruff_cache/

# eval and EDA reports are regenerable, not versioned — keep the dirs.
reports/eval_runs/*
reports/eda/*
!reports/eval_runs/.gitkeep
!reports/eda/.gitkeep

# GCP credential files — never belong in the repo
*-key.json
*service-account*.json
*credentials*.json
client_secret*.json
